{
  "name": "dsh-message-recall",
  "version": "0.3.1",
  "description": "DeepSeek Harness 消息撤回插件：每条用户消息和每条助手回复都有独立的撤回按钮。支持「仅撤回这一条」与「撤回这条及之后」，只向时间线后方作用、绝不触碰更早的消息；撤回会真正进入模型上下文，界面立即响应且不刷新页面。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "message",
    "recall",
    "undo",
    "rewind"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/User-Clb/dsh-message-recall.git"
  },
  "author": "User-Clb",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.cjs",
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check src/recall.js && node --check client.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
