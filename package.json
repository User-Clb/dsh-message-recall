{
  "name": "dsh-message-recall",
  "version": "0.1.0",
  "description": "DeepSeek Harness 消息撤回插件：每条你发出的消息气泡下方、复制按钮旁边都有撤回按钮。支持两种范围——仅撤回本条，或撤回本条及其之后的所有消息；被撤回的内容会真正退出会话与模型上下文，原文自动回填输入框。Web 界面与桌面客户端共用同一份客户端包。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "message",
    "recall",
    "undo",
    "rewind"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/User-Clb/dsh-message-recall.git"
  },
  "author": "User-Clb",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.cjs",
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check src/recall.js && node --check client.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
